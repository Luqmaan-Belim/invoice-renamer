# Copy this file to /etc/invoice-renamer.env and replace every placeholder.
# Keep the real file off GitHub: it contains credentials.
GDRIVE_FOLDER_ID=replace_me
GDRIVE_SA_JSON='replace_with_one_line_service_account_json'
DEBUG_LIST=0
ENABLE_ODOO=1
ODOO_URL=https://www.freshbake.co.za
ODOO_DB=replace_me
ODOO_USER=replace_me
ODOO_API_KEY=replace_me

# Keep each minute-long sweep bounded so new scans are never held up by backlog.
MAX_FILES_PER_RUN=40
# Customer claim_no values loaded from Odoo for claim/debit-note matching.
CLAIM_LOOKBACK_DAYS=365
# Unmatched files are parked and retried later instead of being OCRed every minute.
REVIEW_RETRY_HOURS=6
